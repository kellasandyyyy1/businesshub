# Generate the pair once with: npm run keys
# Real values belong in server/.env, which is gitignored — never in this file.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@yourdomain.com

PORT=3001

# Comma-separated. Add the deployed client origin when you go live.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Leave false to keep notification wording off the server entirely.
LOG_TITLES=false
