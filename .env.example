# ── Local development only ────────────────────────────────────────────────
# Vite inlines every VITE_ variable into the JavaScript bundle, so anything
# here is readable by anyone who opens devtools on a deployed site.
# Use this key for `npm run dev`; do NOT set it in Vercel.
VITE_GROQ_API_KEY=

# The push backend. Must be https:// on a deployed site — a page served over
# https cannot call http, the browser blocks it as mixed content.
# Leave blank and the push toggle simply reads "Not supported"; in-app alerts
# and everything else carry on working.
VITE_PUSH_BACKEND_URL=http://localhost:3001

# ── Set these in the Vercel dashboard, not here ───────────────────────────
# GROQ_API_KEY           the same key, without the VITE_ prefix, so it stays
#                        on the server and never reaches the browser
# VITE_PUSH_BACKEND_URL  https URL of the push server, if you deploy one
